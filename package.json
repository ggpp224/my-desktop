{
  "name": "ai-dev-control-center",
  "version": "0.1.4",
  "type": "module",
  "description": "Desktop app: AI controls dev workflow via local LLM and tools",
  "main": "dist/desktop/electron-main.js",
  "scripts": {
    "verify-ollama": "node scripts/verify-ollama-tools.js",
    "verify:catalog": "tsx scripts/verify-command-catalog.ts",
    "test": "tsx --test agent/intent/**/*.test.ts tools/**/*.test.ts",
    "build": "npm run verify:catalog && tsc && cp desktop/preload.js dist/desktop/ && npm run build:ui",
    "build:ui": "cd ui && npm run build",
    "dev": "tsc && concurrently \"npm run dev:ui\" \"npm run dev:electron\"",
    "dev:server": "tsx watch server/api.ts",
    "dev:electron": "wait-on -t 60000 http://localhost:5173 && echo 'Launching Electron...' && NODE_ENV=development electron .",
    "dev:ui": "cd ui && npm run dev",
    "dev:video-sidecars": "cd services/video-sidecar && (test -x .venv/bin/python || (python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt)) && chmod +x scripts/*.sh 2>/dev/null; PATH=\"/opt/homebrew/bin:$PATH\" FFMPEG_PATH=\"${FFMPEG_PATH:-/opt/homebrew/bin/ffmpeg}\" ./scripts/start-all-sidecars.sh",
    "video:install-real": "cd services/video-sidecar && chmod +x scripts/*.sh && ./scripts/install-real-deps.sh",
    "video:setup-models": "cd services/video-sidecar && chmod +x scripts/*.sh && ./scripts/setup-local-models.sh",
    "video:resume-wan-ckpt": "cd services/video-sidecar && chmod +x scripts/*.sh && ./scripts/resume-wan-ckpt.sh",
    "start": "npm run build && NODE_ENV=production electron .",
    "version:bump": "npm version patch --no-git-tag-version",
    "pack": "npm run version:bump && npm run build && npx electron-builder --mac",
    "pack:mac": "npm run version:bump && npm run build && npx electron-builder --mac",
    "sdk:health": "tsx scripts/sdk-health-check.ts",
    "sdk:pr-review": "tsx scripts/sdk-pr-review.ts",
    "postinstall": "cd ui && npm install"
  },
  "build": {
    "appId": "com.ai-dev-control-center.app",
    "productName": "AI Dev Control Center",
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "ui/dist/**/*",
      "config/**/*",
      "workflows/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.12",
    "@google/genai": "^1.50.1",
    "@llamaindex/ollama": "^0.1.23",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.0",
    "fetch-socks": "^1.3.3",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "llamaindex": "^0.12.1",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "node-html-parser": "^7.1.0",
    "node-pty": "^1.1.0",
    "undici": "^6.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "wait-on": "^8.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
