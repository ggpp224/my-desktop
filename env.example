# AI 生成 By Peng.Guo
# 复制为 .env 后按本机修改。所有路径、Jenkins 任务名、分支、固定网址均在此配置。
# 完整说明见 .cursor/rules/env-constants.mdc

# ---------- 固定网址与目录（config/default.ts 等） ----------
OLLAMA_BASE=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Ollama temperature：Agent/KB 宜低；周报/组内总结略高以增加表述变化
OLLAMA_AGENT_TEMPERATURE=0
OLLAMA_KB_TEMPERATURE=0.1
OLLAMA_WEEKLY_REPORT_TEMPERATURE=0.4
OLLAMA_TEAM_SUMMARY_TEMPERATURE=0.4
# 本地知识库（LlamaIndex + Ollama，仅索引 runtime/private-kb 显式导入文档）
KB_DOC_DIRS=doc,docs,runtime/private-kb
KB_INGEST_MODEL=qwen2.5-coder:14b
KB_CHAT_MODEL=qwen2.5:7b
KB_EMBED_MODEL=bge-m3
KB_PARENT_CHUNK_TOKENS=1200
KB_CHILD_CHUNK_TOKENS=320
KB_CHUNK_OVERLAP_TOKENS=48
KB_NUM_CTX=3072
KB_CONTEXT_WINDOW=4096
KB_FLASH_ATTENTION=1
KB_TOP_K=7
KB_HYBRID_TOP_K=10
KB_HYBRID_ALPHA=0.4
KB_RRF_K=30
KB_MAX_SNIPPET_CHARS=280
KB_RERANK_MODE=rule
KB_RERANK_MODEL=qwen2.5-coder:14b
KB_RERANK_POOL_SIZE=24
# 关键规则补丁调试日志（1=开启；默认建议关闭）
# KB_RULE_PATCH_DEBUG=1
KB_QUERY_TIMEOUT_MS=300000
# Ollama 思考链：仅支持 thinking 的模型可设 true 或 low/medium/high；qwen2.5 等请留空（默认不传）。误设 true 时服务端会自动去掉 think 重试
# OLLAMA_THINK=true
# 周报 write_weekly_report 调用 Ollama 的最长等待（毫秒），默认 600000（10 分钟）
OLLAMA_WEEKLY_REPORT_TIMEOUT_MS=600000
# 本周组内总结 generate_weekly_team_summary：Ollama 超时（默认同 OLLAMA_WEEKLY_REPORT_TIMEOUT_MS）、上下文窗口、最大生成长度、送入模型的 wiki HTML 最大字符数
# OLLAMA_TEAM_SUMMARY_TIMEOUT_MS=600000
# OLLAMA_TEAM_SUMMARY_NUM_CTX=16384
# OLLAMA_TEAM_SUMMARY_NUM_PREDICT=4096
# WEEKLY_TEAM_SUMMARY_MAX_HTML_CHARS=200000
# ---------- 技术趋势（server/trends/，config/default.ts → techDigest） ----------
OLLAMA_TECH_DIGEST_TEMPERATURE=0.3
TECH_DIGEST_GITHUB_LIMIT=50
TECH_DIGEST_HN_LIMIT=30
TECH_DIGEST_REDDIT_LIMIT=20
TECH_DIGEST_FETCH_TIMEOUT_MS=30000
TECH_DIGEST_LLM_TIMEOUT_MS=600000
TECH_DIGEST_REDDIT_GAP_MS=8000
TECH_DIGEST_REDDIT_429_COOLDOWN_MS=45000
TECH_DIGEST_REDDIT_FETCH_TIMEOUT_MS=180000
# 可选：提升 GitHub repo 元数据质量
# GITHUB_TOKEN=
# Reddit 抓取（OAuth 可显著降低 403/429；创建 App: https://www.reddit.com/prefs/apps → script 类型）
# REDDIT_USER_AGENT=desktop:ai-dev-control-center:0.1.4 (by /u/your_reddit_username)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
API_PORT=41738
# ---------- 外部 Gemini（config/default.ts → gemini） ----------
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# 外部模式默认模型（UI 未指定时与后端 fallback 一致）
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
# GEMINI_CONNECT_TIMEOUT_MS=120000
# HTTPS_PROXY=http://127.0.0.1:7890
# 勿在 .env 设置 PORT：cc-web cjet dev / webpack-dev-server 会读 process.env.PORT，与 API 抢端口导致 SIGKILL
# 开发时 API / Terminal Broker 子进程用的 node 可执行文件（默认自动用 PATH 里的 node）
# SUBPROCESS_NODE=/usr/local/bin/node
# 内嵌 PTY 子进程端口（默认 API_PORT+1）
# TERMINAL_BROKER_PORT=41739
# 仅浏览器直连 Vite 开发 UI 时使用（Electron 内通过 preload 获取端口，可不设）
# VITE_API_URL=http://localhost:41738
SHELL_CWD=

# macostunmode（「tun」指令）
# MACOSTUNMODE_DIR=
# sudo 密码；留空则在系统终端手动输入
# MACOSTUNMODE_SUDO_PASSWORD=

# Jenkins 服务与认证
JENKINS_BASE_URL=https://jenkins.rd.chanjet.com/
JENKINS_USERNAME=
JENKINS_TOKEN=

# Jira 服务与认证（Jira 8.8，非 token）
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_PASSWORD=
# 可选：开发人员字段 id（如 customfield_10001）；不填则首次查询时从 Jira /rest/api/2/field 按名称「开发人员」自动解析
# JIRA_DEVELOPER_FIELD_ID=
# 可选：特性字段 id（如 customfield_16202）；不填则首次查询时从 Jira /rest/api/2/field 按名称「特性」自动解析
# JIRA_FEATURE_FIELD_ID=
# 列表「提测」一键默认值（工作流 transition 名称与填表）
JIRA_SUBMIT_TEST_TRANSITION_NAME=提测
JIRA_SUBMIT_TEST_TESTER=wangqw
JIRA_SUBMIT_TEST_CAN_GRAYSCALE=能
JIRA_SUBMIT_TEST_MODIFICATION_TEMPLATE=修复：{摘要}
JIRA_SUBMIT_TEST_SCOPE_TEMPLATE=验证：{摘要}
# 可选：缺陷原因选项文案；留空或与 Jira 选项不匹配则不传该字段
# JIRA_SUBMIT_TEST_DEFECT_CAUSE=

# Wiki/Confluence 服务与认证（周报指令）
WIKI_BASE_URL=https://wiki2.rd.chanjet.com
WIKI_WEEKLY_SPACE_NAME=低代码单据前端空间
WIKI_WEEKLY_ROOT_PAGE_ID=405143687
WIKI_TOKEN=
# 鉴权前缀，常见为 Bearer；如你们平台要求 Token，可改成 Token
WIKI_AUTH_SCHEME=Bearer

# Cursor 用量 API（可选覆盖地址，默认已内置）
# Cursor SDK API Key（用于 scripts/sdk-health-check.ts）
CURSOR_API_KEY=
# Cursor SDK 模型（默认 default，可改成 composer-2 / gpt-5.5 等）
CURSOR_SDK_MODEL=default
# Cursor SDK PR 审查参数（可选）
CURSOR_SDK_REVIEW_MODEL=default
CURSOR_SDK_REVIEW_BASE=main
CURSOR_USAGE_API_URL=https://cursor.com/api/dashboard/get-aggregated-usage-events
CURSOR_TODAY_USAGE_API_URL=https://cursor.com/api/dashboard/get-filtered-usage-events
# 二选一配置认证（推荐 token）
CURSOR_API_TOKEN=
CURSOR_COOKIE=
# Cursor 用量统计范围参数（按每月固定锚点时间计算 startDate）
CURSOR_TEAM_ID=-1
CURSOR_USAGE_MONTHLY_BASE_START=1774764813000
# Cursor 今日用量分页参数
CURSOR_TODAY_PAGE=1
CURSOR_TODAY_PAGE_SIZE=10
# Cursor API 的来源校验头（一般保持默认）
CURSOR_API_ORIGIN=https://cursor.com
CURSOR_API_REFERER=https://cursor.com/dashboard

# ---------- Jenkins 默认分支（config/projects.ts：部署时 BRANCH_NAME） ----------
JENKINS_DEFAULT_BRANCH_PRETEST=test-260423
JENKINS_DEFAULT_BRANCH_NOVA=test

# ---------- 合并目标分支（config/projects.ts：merge 接口目标分支） ----------
MERGE_TARGET_BRANCH_PRETEST=test-260423
MERGE_TARGET_BRANCH_NOVA=test

